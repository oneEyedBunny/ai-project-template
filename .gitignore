# Secrets — NEVER commit these. This is the most important section.
# A committed key lives in git history forever, even after you delete the file.
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
**/secrets/

# Dependencies
node_modules/
.pnp/
.pnp.js
vendor/

# Build output
dist/
build/
out/
.next/
.output/
.vite/

# Test / coverage artifacts
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.parcel-cache/
.eslintcache
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases / data
*.sqlite
*.sqlite3
*.db
/local-data/

# Editor & OS cruft (personal, machine-specific)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code: shared permissions are committed (.claude/settings.json); personal
# per-machine overrides are not.
.claude/settings.local.json

# Local working docs — planning scaffolding, not deliverables.
# This repo ships everything by default (see docs/handoff.md), so anything that is
# genuinely internal has to opt out by name. Use the .local.md suffix for scratch plans,
# setup notes, and anything half-formed you don't want a client reading.
*.local.md

# NOTE: The .ai/ context files, docs/, and specs/ are intentionally NOT ignored.
# They are the shared source of truth — teammates, the client, and Claude must all get
# them on clone. They ship with the project (see docs/handoff.md).
