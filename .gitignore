# Secrets — NEVER commit these. This is the most important section.
# A committed key lives in git history forever, even after you delete the file.
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
**/secrets/

# Dependencies
node_modules/
.pnp/
.pnp.js
vendor/

# Build output
dist/
build/
out/
.next/
.output/
.vite/

# Test / coverage artifacts
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.parcel-cache/
.eslintcache
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases / data
*.sqlite
*.sqlite3
*.db
/local-data/

# Editor & OS cruft (personal, machine-specific)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# NOTE: The .ai/ context files, docs/, and specs/ are intentionally NOT ignored.
# They are the shared source of truth — teammates and Claude must get them on clone.
# Keeping internal files out of the CLIENT's copy is handled separately, by the
# two-repo handoff (see docs/handoff.md), NOT by gitignore.
